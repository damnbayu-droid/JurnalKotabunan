# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# editor
.vscode/

# AI-generated article images - regeneratable via scripts/regenerate-images.ts,
# not meant to live in git history (binary blobs, grows unbounded).
/public/uploads/

# one-off operational logs/backups from maintenance scripts - useful locally
# right after a run, not meant to be permanent repo history.
scripts/*.log
scripts/content-backup-*.json
scripts/content-upgrade-backup-*.json

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
dev.log
test
prompt

server.log
# Skills directory
/skills/
# User seed-research working docs - kept local, not committed (per owner)
seedrisetjurnalkotabunan*.md
