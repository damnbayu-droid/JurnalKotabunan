# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.
#
# SETTING UP A NEW/SIBLING PROJECT FROM THIS CODEBASE (e.g. a different
# brand/domain reusing this same code)? Every value below is an account or
# credential specific to the ORIGINAL deployment - none of them should be
# reused as-is. Get a fresh key/account for each service, even the free
# ones, so the two projects stay fully independent (separate rate limits,
# separate billing, separate blast radius if one leaks). Lines marked
# "SITE-SPECIFIC" below are places a plain copy-paste is almost certainly
# wrong, not just "should get your own key" - actively double-check those.

# Database connection for Prisma (Supabase - Transaction Pooler). Keep
# connection_limit=1 (this project's pooled Supabase tier can't handle
# more), but append &pool_timeout=60 - the default 10s timeout is too
# short for `next build`'s static generation, which queries the DB from
# several pages (category pages, ads) that end up queueing for the single
# connection. Confirmed via a real failed Vercel build ("Timed out
# fetching a new connection from the connection pool... connection
# limit: 1") that reproduced locally too - pool_timeout=60 fixed it. If
# your Supabase tier's pooled connection_limit is higher than 1, raise
# this to match and pool_timeout can likely drop back toward the default.
# Example: postgresql://user:pass@host:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=60
DATABASE_URL=

# Direct (non-pooled) connection - used for `prisma db push`/migrations,
# which need a session-level connection rather than the transaction pooler.
# Supabase dashboard -> Settings -> Database -> Connection string -> Session pooler.
DIRECT_URL=

# Supabase public credentials (dashboard -> Settings -> API). SITE-SPECIFIC -
# every Supabase project has its own URL + anon key, always get fresh ones.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Storage - server-side image/video/PDF uploads (article photos, ad
# creatives, advertiser payment proofs - see src/lib/storage/upload-image.ts).
# NOT the anon key above - this is the service_role key (Supabase dashboard
# -> Settings -> API -> service_role, "secret" section). It bypasses Row
# Level Security, so it's server-only and must NEVER be exposed with a
# NEXT_PUBLIC_ prefix. Requires a PUBLIC bucket named "article-images" to
# exist in Supabase Storage first (dashboard -> Storage -> New bucket).
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Blob - FALLBACK image storage, only used if a Supabase Storage
# upload fails (redundancy so one storage backend having an issue doesn't
# mean articles publish with no photo). Get this by creating a Blob store in
# the Vercel dashboard (Project -> Storage -> Create -> Blob) and connecting
# it to this project - Vercel injects this env var automatically once
# connected, both locally (via `vercel env pull`) and in production. Optional
# for local dev (Supabase alone is fine there); recommended for production.
BLOB_READ_WRITE_TOKEN=

# Authentication (NextAuth) - dead config, kept only so nothing looks unset.
# The "next-auth" package is installed but never actually imported anywhere
# in src/; real auth is the custom bcrypt + DB session-token system in
# src/lib/auth/session.ts. NEXTAUTH_SECRET can be any random string (e.g.
# `openssl rand -base64 32`); NEXTAUTH_URL should be your site's real URL.
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# ==============================================================================
# CRON / SCHEDULED JOBS - protects every /api/cron/* route AND the QStash
# delayed-callback route (/api/articles/[id]/auto-check-fatality). Without
# this set, those routes have NO auth check at all (skipped when the env var
# is missing) and are publicly triggerable by anyone who knows the URL. Set
# to any random string (e.g. `openssl rand -hex 32`) - Vercel Cron sets it
# automatically as the Authorization header once this env var exists in the
# project's settings; QStash is configured to forward it the same way (see
# QSTASH_TOKEN below).
# ==============================================================================
CRON_SECRET=

# Upstash QStash (https://console.upstash.com/qstash) - powers the ONE-TIME
# delayed re-check for a single HIGH-risk article (NOT a recurring scan of
# all articles): when Check Fatality resolves an article to HIGH but it
# still can't publish, this schedules exactly one automatic re-check of
# THAT article 10 minutes later. Free tier is 500 messages/day, far more
# than this needs. Without this set, that one-time re-check is simply
# skipped (logged as a warning) - nothing breaks, the article just needs a
# manual "Check & Perbaiki Risiko" click instead. QSTASH_URL is optional -
# it pins requests to one regional QStash cluster (must match the token's
# region); omit it to use the global routing endpoint instead.
# SITE-SPECIFIC - a QStash token from one project's dashboard forwards
# CRON_SECRET as a header, so reusing it across two sites would let each
# site's delayed callbacks land on the wrong domain.
QSTASH_URL=
QSTASH_TOKEN=

# IndexNow (https://www.indexnow.org) - submits newly-published article URLs
# to Bing/Yandex/etc. directly instead of waiting for their crawlers to find
# them (see src/lib/indexnow.ts, src/app/api/cron/indexnow-submit). Get a key
# from Bing Webmaster Tools -> your site -> IndexNow, then host it at your
# site's root as a matching key file: public/<key>.txt containing just the
# key text (see the existing file in this repo for the exact format).
# SITE-SPECIFIC, and requires the matching .txt FILE, not just this env
# var - a key issued for one domain will fail verification for another.
# Missing this just skips submission (logged once), nothing else breaks.
INDEXNOW_KEY=

# ==============================================================================
# MYAI OS GATEWAY (unified AI provider for all agents - Wie, Audy, As, Wue).
# OpenAI-compatible endpoint. Get your API key from https://console.myai.nexus
# Per-agent model routing lives in src/lib/ai/myaiClient.ts (MYAI_FIELDS).
# ==============================================================================
MYAI_API_KEY=
MYAI_BASE_URL="https://console.myai.nexus/api/v1"

# ==============================================================================
# FALLBACK TEXT PROVIDERS - free/cheap OpenAI-compatible chat providers.
# src/lib/ai/fallback-router.ts routes every myaiComplete/myaiCompleteJSON
# call here whenever MYAI_API_KEY is unset, OR a MyAI OS call throws and at
# least one key below is present. Prompts + callers are unchanged; set
# MYAI_API_KEY later and everything reverts to MyAI OS automatically.
#
# Provider order (default "auto"): Groq -> OpenRouter -> Z.ai. Add numbered
# keys (KEY1, KEY2, ...) and/or the bare name; all are rotated per call to
# multiply per-key daily limits. This is what runs the historical-news seed.
#
#   AI_TEXT_PROVIDER   auto (default) | groq | openrouter | zai | "b,a" reorder
#   GROQ_MODEL         default: groq/compound-mini. Groq's free tier caps
#                      gpt-oss/qwen at 8,000 tokens/MINUTE (prompt+output),
#                      too small for a long article + our full prompt -> 413.
#                      compound-mini gets 70,000/min. Use openai/gpt-oss-120b
#                      only for short, high-quality calls.
#   OPENROUTER_MODEL   default: minimax/minimax-m3:free  (OpenRouter's free
#                      models share one rate pool and 429 often - overflow
#                      only; the slug list churns, override as needed)
#   ZAI_MODEL          default: glm-4.5-flash (free, ~25s/call). With a
#                      funded Z.ai balance, set glm-4.6 (fast + cheap).
# ==============================================================================
# Groq - https://console.groq.com/keys   (~30 req/min, ~1k req/day per key)
GROQ_API_KEY=
GROQ_API_KEY1=
GROQ_API_KEY2=
# OpenRouter - https://openrouter.ai/keys   (~20 req/min, 50-1000 req/day, pooled)
OPENROUTER_API_KEY=
OPENROUTER_API_KEY1=
OPENROUTER_API_KEY2=
# Z.ai / GLM - https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=
# Optional overrides:
# AI_TEXT_PROVIDER=auto
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=minimax/minimax-m3:free
# ZAI_MODEL=glm-4.5-flash

# ==============================================================================
# GOOGLE AI STUDIO (Gemini) - direct, outside MyAI OS. https://aistudio.google.com/apikey
# Used for: (1) real image generation - MyAI OS's gemini-3.1-flash-lite-image
# catalog entry isn't wired to any callable field yet, and (2) the NSFW
# vision-check gate on generated images - MyAI OS's /chat/completions 500s on
# any multimodal (array-shaped) `content`, confirmed by direct test, so image
# input has to go through a provider that actually supports it.
#
# src/lib/ai/providers/gemini.ts rotates through UP TO SIX keys (this one
# plus GEMINI_API_KEY1-5) to spread usage across separate free-tier
# projects/spend caps - only GEMINI_API_KEY is required, the numbered ones
# are optional extra capacity, but if you have them locally, all of them
# need to be added to Vercel too, not just this one.
# ==============================================================================
GEMINI_API_KEY=
GEMINI_API_KEY1=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GEMINI_API_KEY4=
GEMINI_API_KEY5=

# ==============================================================================
# UNSPLASH - real stock photography (not generative), free tier.
# https://unsplash.com/developers -> create an app -> Access Key.
# Used only as an extra rotation source for one-off bulk backfill batches
# (see scripts/bulk-backfill-content.ts) - the site's normal day-to-day
# generation doesn't touch this. Optional: missing key just skips this
# source in rotation, same fallback behavior as every other candidate.
# ==============================================================================
UNSPLASH_ACCESS_KEY=

# ==============================================================================
# EMAIL (Resend) - powers the Admin Dashboard's Email panel (reply to
# Contact Form submissions) and the Newsletter system (welcome email on
# subscribe, digest email when new articles publish - see
# src/lib/email/resend.ts and src/lib/email/newsletter.ts). Get an API key
# at https://resend.com/api-keys, then verify your sending domain at
# https://resend.com/domains before RESEND_FROM_EMAIL will actually work -
# an unverified domain's sends get rejected. No Gmail/SMTP app password
# needed anywhere in this flow - Resend sends independently via its own
# API key, it never touches a Gmail account's credentials.
#
# SITE-SPECIFIC - RESEND_FROM_NAME/RESEND_FROM_EMAIL below are placeholder
# EXAMPLE values from the original deployment, not sensible defaults. Set
# them to your own site's name and a verified address on YOUR domain -
# leaving them as "Bali Journal"/balijournal.com would send mail claiming
# to be a site you don't run.
# ==============================================================================
RESEND_API_KEY=
RESEND_FROM_NAME="Bali Journal"
RESEND_FROM_EMAIL=contact@balijournal.com
