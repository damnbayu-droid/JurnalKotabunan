// Jurnal Kotabunan - Investigative Journalism Platform
// Production-ready database schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User Roles
enum Role {
  ADMIN
  EDITOR
  USER
  ADVERTISER
}

// Article Categories
enum Category {
  GOVERNMENT
  TOURISM
  INVESTMENT
  INCIDENTS
  ENVIRONMENT
  PANANG
  INTERNATIONAL
  TECHNOLOGY
  OPINION
}

// Legal Risk Levels
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Verification Levels
enum Verification {
  LOW
  MEDIUM
  HIGH
}

// Article Status
enum Status {
  DRAFT
  REVIEW
  PUBLISHED
  REJECTED
  SCHEDULED
  // Soft-delete state (Trash panel) - articles moved here via DELETE
  // /api/articles/[id] instead of being hard-deleted immediately. Every
  // public-facing query filters on a SPECIFIC status (PUBLISHED), never
  // "not DRAFT" or similar, so adding this value automatically excludes
  // trashed articles from the live site with no changes needed to those
  // ~13 query sites - only the admin's own listing endpoints needed an
  // explicit `status: { not: TRASHED }` added.
  TRASHED
}

// Comment Status
enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

// Users Model
model User {
  id          String       @id @default(uuid())
  email       String       @unique
  password    String?
  name        String?
  role        Role         @default(USER)
  avatar      String?
  bio         String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  comments    Comment[]
  articles    Article[]
  subscribers Subscriber[]
  sessions    Session[]
  advertiser  Advertiser?

  @@map("users")
}

// Articles Model
model Article {
  id                  String          @id @default(uuid())
  title               String
  slug                String          @unique
  excerpt             String
  content             String
  category            Category
  featuredImageUrl    String?
  featuredImageAlt    String?
  imageSource         String?
  sourceUrl           String? // External source URL for rewritten articles
  aiAssisted          Boolean         @default(false)
  riskLevel           RiskLevel       @default(LOW)
  riskScore           Int             @default(0)
  containsAccusation  Boolean         @default(false)
  verificationLevel   Verification    @default(LOW)
  evidenceCount       Int             @default(0)
  legalReviewRequired Boolean         @default(false)
  legalReviewedBy     String?
  legalReviewedAt     DateTime?
  status              Status          @default(DRAFT)
  // Set only when status is TRASHED - what to restore `status` to. Kept
  // separate from `status` itself so restore doesn't need to guess whether
  // a trashed article used to be DRAFT/PUBLISHED/etc.
  previousStatus      Status?
  deletedAt           DateTime? // When moved to trash - null otherwise
  viewCount           Int             @default(0)
  likeCount           Int             @default(0)
  shareCount          Int             @default(0)
  // Set once this article's URL has been submitted to IndexNow (Bing,
  // Yandex, etc. - see src/lib/indexnow.ts) - null means "not submitted
  // yet", picked up by the indexnow-submit cron.
  indexNowSubmittedAt DateTime?
  // Set once this article has been included in a newsletter digest sent to
  // subscribers (see src/app/api/cron/newsletter-notify/route.ts) - null
  // means "not notified yet".
  newsletterSentAt    DateTime?
  authorId            String
  author              User            @relation(fields: [authorId], references: [id])
  evidences           Evidence[]
  comments            Comment[]
  aiActivityLogs      AiActivityLog[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  publishedAt         DateTime?

  @@index([category])
  @@index([status])
  @@index([publishedAt])
  @@index([createdAt])
  @@index([riskLevel])
  @@map("articles")
}

// Evidence Model
model Evidence {
  id          String   @id @default(uuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  fileUrl     String
  type        String // document, image, video, audio
  source      String
  description String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("evidences")
}

// Comments Model (Account Required)
model Comment {
  id             String        @id @default(uuid())
  content        String
  articleId      String
  article        Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  parentId       String?
  status         CommentStatus @default(PENDING)
  toxicityScore  Float?
  legalRiskScore Float?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([articleId])
  @@index([userId])
  @@index([status])
  @@map("comments")
}

// Subscribers Model
model Subscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  active    Boolean  @default(true)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@map("subscribers")
}

// Audit Log for Legal Compliance
model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String
  userId    String?
  metadata  String? // JSON string
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@map("audit_logs")
}

// AI Settings for automation control
model AiSettings {
  id             String    @id @default(cuid())
  autoPublish    Boolean   @default(false)
  dailyLimit     Int       @default(3)
  lastGeneration DateTime?
  agentStatus    Json? // Real-time status of each agent { "AUDY": "...", "AS": "..." }
  agentActivity  String? // Current activity description e.g. "Thinking", "Writing"
  healthStatus   Json? // API connection status { "openai": "ok", "db": "ok" }
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("ai_settings")
}

// AI Activity Log for monitoring
model AiActivityLog {
  id        String    @id @default(cuid())
  action    String // "generate", "rewrite", "analyze"
  category  Category?
  sourceUrl String? // For rewrites
  articleId String?
  article   Article?  @relation(fields: [articleId], references: [id], onDelete: SetNull)
  success   Boolean   @default(true)
  metadata  Json? // Store AI thoughts, decisions, etc.
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@map("ai_activity_logs")
}

// Sessions for Auth
model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Reports from Public
model Report {
  id            String   @id @default(cuid())
  title         String
  category      String
  content       String
  sourceContact String?
  evidenceLinks String? // JSON string or comma-separated
  status        String   @default("PENDING") // PENDING, REVIEWED, ARCHIVED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("reports")
}

// Public masthead roster - admin-editable, shown on About Us and the
// Editorial Team page. Deliberately starts empty rather than seeded with
// placeholder names/headcounts.
model TeamMember {
  id        String   @id @default(uuid())
  name      String
  role      String
  bio       String?
  photoUrl  String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_members")
}

// Editable Schedule Configuration
model ScheduleConfig {
  id          String    @id @default(cuid())
  time        String // e.g. "06:00", checked against current time by the
  // schedule-check cron (src/app/api/cron/schedule-check/route.ts) every
  // 10 minutes - previously this field was saved but NEVER read by
  // anything that actually triggers generation (confirmed 2026-09-02: no
  // cron, no client polling, called it at all), so setting a time here did
  // nothing. Fixed alongside this schema change.
  label       String // e.g. "Hot News"
  slots       Int       @default(1) // articles to generate per run, for `category` if set, or split across ALL categories if null
  category    Category? // null = rotate across all 7 categories; a specific value = only that category
  isActive    Boolean   @default(true)
  lastRunDate String? // "YYYY-MM-DD" (site-local date) of the last successful run - prevents the cron re-triggering the same slot multiple times within its matching window on the same day
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("schedule_configs")
}

// One row per public search performed (src/app/search/page.tsx) - powers
// the admin Metrics panel's "Most Searched" indicator. Never existed before
// (search queries weren't tracked at all) - added 2026-09-02.
model SearchQuery {
  id          String   @id @default(uuid())
  query       String
  resultCount Int
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([query])
  @@map("search_queries")
}

// Persistent memory for the newsroom AI agents (Wie/Audy/As/Wue) - DIY
// replacement for a dedicated vector-memory service, backed by pgvector.
// `embedding` is written/read via raw SQL ($queryRaw/$executeRaw) since
// Prisma Client doesn't support the `vector` type through its normal API.
model AgentMemory {
  id        String                      @id @default(uuid())
  agentKey  String // WIE, AUDY, AS, WUE
  category  String? // e.g. "legal-risk-decision", "moderation-precedent", "editorial-style"
  content   String
  embedding Unsupported("vector(384)")?
  metadata  Json?
  createdAt DateTime                    @default(now())

  @@index([agentKey])
  @@index([category])
  @@map("agent_memories")
}

// ==============================================================================
// ADS (Fase 1: dikelola admin sepenuhnya - belum ada dashboard advertiser
// self-service/invoice/payment, itu Fase 2 terpisah).
// ==============================================================================

enum AdPosition {
  HEADER
  SIDEBAR
  IN_ARTICLE
  FOOTER
  MOBILE_BANNER
  HOME_HERO_LEFT
  HOME_HERO_MINI
  HOME_HERO_BELOW
  ARTICLE_LEFT
  ARTICLE_LEFT_BOTTOM
  ARTICLE_RIGHT_TOP
  ARTICLE_RIGHT_BOTTOM
}

enum AdDevice {
  DESKTOP
  MOBILE
  BOTH
}

enum AdMediaType {
  IMAGE
  VIDEO
}

model AdSlot {
  id                  String     @id @default(uuid())
  name                String
  position            AdPosition
  device              AdDevice
  width               Int
  height              Int
  pricePerDay         Int?
  defaultDurationDays Int        @default(7)
  ads                 Ad[]
  createdAt           DateTime   @default(now())

  @@map("ad_slots")
}

model Ad {
  id             String      @id @default(uuid())
  slotId         String
  slot           AdSlot      @relation(fields: [slotId], references: [id], onDelete: Cascade)
  advertiserName String
  mediaUrl       String
  mediaType      AdMediaType
  linkUrl        String?
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  advertiserId   String?
  advertiser     Advertiser? @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  invoice        Invoice?

  @@index([slotId])
  @@index([advertiserId])
  @@map("ads")
}

enum AdvertiserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdvertiserType {
  COMPANY
  INDIVIDUAL
}

model Advertiser {
  id              String           @id @default(uuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  advertiserType  AdvertiserType   @default(COMPANY)
  companyName     String
  phone           String
  status          AdvertiserStatus @default(PENDING)
  rejectionReason String?
  ads             Ad[]
  invoices        Invoice[]
  createdAt       DateTime         @default(now())

  @@map("advertisers")
}

enum InvoiceStatus {
  UNPAID
  VERIFYING
  PAID
  REJECTED
}

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique
  advertiserId    String
  advertiser      Advertiser    @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  adId            String        @unique
  ad              Ad            @relation(fields: [adId], references: [id], onDelete: Cascade)
  amount          Int
  status          InvoiceStatus @default(UNPAID)
  proofUrl        String?
  rejectionReason String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())

  @@index([advertiserId])
  @@map("invoices")
}

model CompanySettings {
  id              String   @id @default(uuid())
  companyName     String?
  address         String?
  npwp            String?
  phone           String?
  bankName        String?
  bankAccountNo   String?
  bankAccountName String?
  updatedAt       DateTime @updatedAt

  @@map("company_settings")
}

// Contact Form Submissions
model ContactSubmission {
  id          String    @id @default(cuid())
  name        String
  email       String
  subject     String
  message     String
  status      String    @default("UNREAD") // UNREAD, READ, ARCHIVED, REPLIED
  // Set once an admin sends a reply from the Admin Dashboard Email panel
  // (src/app/api/admin/contact-submissions/[id]/reply) - sent via Resend,
  // not stored as a full thread (this site has no reply-to-a-reply flow;
  // further back-and-forth happens over normal email once the reply lands
  // in the visitor's inbox).
  replyMessage String?
  repliedBy    String?
  repliedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("contact_submissions")
}
